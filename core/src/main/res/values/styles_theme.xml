<resources>
  <style name="SnackBarStyle" parent="Widget.Design.Snackbar" />

  <style name="SnackBarButtonStyle" parent="Widget.MaterialComponents.Button.TextButton.Snackbar">
    <item name="android:textColor">?attr/colorPrimary</item>
    <item name="android:textSize">@dimen/text_size_small</item>
  </style>

  <style name="SnackBarTextStyle" parent="Widget.MaterialComponents.Snackbar.TextView">
    <item name="android:textColor">@color/white</item>
    <item name="android:textSize">@dimen/text_size_small</item>
    <item name="android:ellipsize">end</item>
    <item name="android:maxLines">2</item>
  </style>

  <style name="BaseDialogTheme" parent="Theme.MaterialComponents.Dialog.Alert">
    <item name="colorPrimary">@color/blue</item>
    <item name="android:windowBackground">@drawable/background_dialog</item>
    <item name="android:windowIsFloating">true</item>
    <item name="android:windowSoftInputMode">adjustResize</item>
    <item name="snackbarStyle">@style/SnackBarStyle</item>
    <item name="snackbarButtonStyle">@style/SnackBarButtonStyle</item>
    <item name="snackbarTextViewStyle">@style/SnackBarTextStyle</item>
  </style>
</resources>
